module topology_manual;

// Illustrative isotropic material and manual loads, not a calibrated robot part.
material AluminiumFixture {
    density: 2700 kg/m3;
    young: 70 GPa;
    poisson: 0.3;
    yield_strength: 250 MPa;
}
component manual_support() -> Solid {
    return topology(
        name: "manual_support",
        domain: box(size: [120 mm, 40 mm, 20 mm]),
        preserve: [
            interface(name: "mount", shape: box(size: [10 mm, 40 mm, 20 mm])),
            interface(name: "loaded", shape: translate(offset: [110 mm, 0 mm, 0 mm],
                shape: box(size: [10 mm, 40 mm, 20 mm])))
        ],
        void: [],
        material: AluminiumFixture,
        load_cases: [
            load_case(name: "down", loads: [force(on: "loaded", vector: [0 N, 0 N, -1 N])],
                supports: [fixed(on: "mount")]),
            load_case(name: "up", loads: [force(on: "loaded", vector: [0 N, 0 N, 1 N])],
                supports: [fixed(on: "mount")])
        ],
        objective: maximize_stiffness,
        constraints: [volume_fraction(0.85), max_mass(230 g), max_displacement(0.01 mm)],
        manufacturing: []);
}
part Support {
    material: AluminiumFixture;
    body = manual_support();
}
